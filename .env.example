# Server
PORT=3001
NODE_ENV=development
# Comma-separated in dev since the Vite frontend's port varies by project config.
CLIENT_ORIGIN=http://localhost:8443,http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/morphofit

# Auth — used to sign session JWTs (see src/middleware/auth.js)
JWT_SECRET=local-development-secret
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Public URL of the frontend — used to build links inside emails (verify
# address, reset password, deep links to an order). Defaults to the first
# CLIENT_ORIGIN entry when unset.
APP_URL=http://localhost:8443

# Leave MAIL_ENABLED=false for local dev: every email is logged to the console
# instead of being delivered. The seeded demo accounts (client@morphofit.com
# etc.) are not real addresses and WILL hard-bounce if you send to them, so
# only turn this on once you're using real accounts.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465; false for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MorphoFit <no-reply@morphofit.com>

# Comma-separated recipient domains to drop instead of sending (they'd only
# hard-bounce, and the bounces count against your sending reputation).
# morphofit.com is the seeded demo accounts' domain and has no MX record.
# Set this empty to deliver to every address.
MAIL_SKIP_DOMAINS=morphofit.com

# How long verification / password-reset links stay valid
EMAIL_TOKEN_TTL_HOURS=24

# ── Body Scan AI analysis (Gemini) ─────────────────────────────────────────
# Server-side only — never expose this key to the frontend. Photos are sent to
# Google for analysis; check your key tier's data-use terms (body photos are sensitive).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated, tried in order if the primary model returns 503/429 or hangs.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# minimal (fast, ~12s) | low | medium | high | none (omit the setting)
GEMINI_THINKING_LEVEL=minimal
# Optional override of the API base URL (defaults to Google AI Studio v1beta).
# GEMINI_API_BASE=
