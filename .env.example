# Server
PORT=3001
NODE_ENV=development
# Comma-separated in dev since the Vite frontend's port varies by project config.
CLIENT_ORIGIN=http://localhost:8443,http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/morphofit

# Auth — used to sign session JWTs (see src/middleware/auth.js)
JWT_SECRET=local-development-secret
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Public URL of the frontend — used to build links inside emails (verify
# address, reset password, deep links to an order). Defaults to the first
# CLIENT_ORIGIN entry when unset.
APP_URL=http://localhost:8443

# Leave MAIL_ENABLED=false for local dev: every email is logged to the console
# instead of being delivered. The seeded demo accounts (client@morphofit.com
# etc.) are not real addresses and WILL hard-bounce if you send to them, so
# only turn this on once you're using real accounts.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465; false for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MorphoFit <no-reply@morphofit.com>

# How long verification / password-reset links stay valid
EMAIL_TOKEN_TTL_HOURS=24
